@model Subject

@{
    ViewData["Title"] = "Subject Details";
}

<div class="page-heading">
    <h2 class="mb-0"><i class="bi bi-journal-bookmark text-primary"></i> Subject Details</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SubjectCode)</dt>
            <dd class="col-sm-9">@Model.SubjectCode</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Teacher</dt>
            <dd class="col-sm-9">@(Model.Teacher?.FullName ?? "-")</dd>
            <dt class="col-sm-3">Classroom</dt>
            <dd class="col-sm-9">@(Model.ClassRoom?.DisplayName ?? "-")</dd>
        </dl>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-white fw-semibold"><i class="bi bi-award"></i> Recorded Grades</div>
    <div class="card-body">
        @if (Model.Grades.Any())
        {
            <table class="table table-sm mb-0">
                <thead><tr><th>Student</th><th>Exam Type</th><th>Score</th><th>Exam Date</th></tr></thead>
                <tbody>
                @foreach (var grade in Model.Grades.OrderByDescending(g => g.ExamDate))
                {
                    <tr>
                        <td>@(grade.Student?.FullName ?? "-")</td>
                        <td>@grade.ExamType</td>
                        <td>@grade.Score</td>
                        <td>@grade.ExamDate.ToString("dd MMM yyyy")</td>
                    </tr>
                }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mb-0">No grades recorded yet.</p>
        }
    </div>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
