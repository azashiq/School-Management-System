@model IEnumerable<Attendance>

@{
    ViewData["Title"] = "Attendance";
}

<div class="page-heading">
    <h2 class="mb-0"><i class="bi bi-calendar-check-fill text-primary"></i> Attendance Records</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Record Attendance</a>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>Student</th>
                        <th>@Html.DisplayNameFor(model => model.Date)</th>
                        <th>Status</th>
                        <th>@Html.DisplayNameFor(model => model.Remarks)</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(item.Student?.FullName ?? "-")</td>
                        <td>@item.Date.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (item.IsPresent)
                            {
                                <span class="badge badge-present">Present</span>
                            }
                            else
                            {
                                <span class="badge badge-absent">Absent</span>
                            }
                        </td>
                        <td>@item.Remarks</td>
                        <td class="text-end action-btn-group">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">No attendance records found.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
