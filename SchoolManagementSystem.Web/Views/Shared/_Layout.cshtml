<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - School Management System</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Students" asp-action="Index">
                    <i class="bi bi-mortarboard-fill me-2"></i>School Management System
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMenu">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Students" asp-action="Index"><i class="bi bi-people-fill"></i> Students</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Teachers" asp-action="Index"><i class="bi bi-person-workspace"></i> Teachers</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="ClassRooms" asp-action="Index"><i class="bi bi-door-open-fill"></i> Classrooms</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Subjects" asp-action="Index"><i class="bi bi-journal-bookmark-fill"></i> Subjects</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Attendances" asp-action="Index"><i class="bi bi-calendar-check-fill"></i> Attendance</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Grades" asp-action="Index"><i class="bi bi-award-fill"></i> Grades</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid py-4">
        @if (TempData["SuccessMessage"] is not null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-1"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] is not null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 mt-4">
        <div class="container-fluid text-center">
            &copy; @DateTime.Now.Year - School Management System
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
