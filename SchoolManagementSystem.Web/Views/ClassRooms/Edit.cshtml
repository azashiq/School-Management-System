@model ClassRoom

@{
    ViewData["Title"] = "Edit Classroom";
}

<div class="page-heading">
    <h2 class="mb-0"><i class="bi bi-pencil-square text-warning"></i> Edit Classroom</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="IsDeleted" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Section" class="form-label"></label>
                    <input asp-for="Section" class="form-control" />
                    <span asp-validation-for="Section" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Capacity" class="form-label"></label>
                    <input asp-for="Capacity" type="number" class="form-control" min="1" />
                    <span asp-validation-for="Capacity" class="text-danger"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-warning"><i class="bi bi-check-circle"></i> Update Classroom</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
