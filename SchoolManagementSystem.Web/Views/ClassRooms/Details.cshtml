@model ClassRoom

@{
    ViewData["Title"] = "Classroom Details";
}

<div class="page-heading">
    <h2 class="mb-0"><i class="bi bi-door-open text-primary"></i> Classroom Details</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Name)</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Section)</dt>
            <dd class="col-sm-9">@Model.Section</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Capacity)</dt>
            <dd class="col-sm-9">@Model.Capacity</dd>
        </dl>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-white fw-semibold"><i class="bi bi-people"></i> Students (@Model.Students.Count)</div>
    <div class="card-body">
        @if (Model.Students.Any())
        {
            <ul class="list-group list-group-flush">
                @foreach (var student in Model.Students)
                {
                    <li class="list-group-item">@student.FullName (@student.RegistrationNumber)</li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted mb-0">No students enrolled yet.</p>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-white fw-semibold"><i class="bi bi-journal-bookmark"></i> Subjects</div>
    <div class="card-body">
        @if (Model.Subjects.Any())
        {
            <ul class="list-group list-group-flush">
                @foreach (var subject in Model.Subjects)
                {
                    <li class="list-group-item">@subject.Name — @(subject.Teacher?.FullName ?? "Unassigned")</li>
                }
            </ul>
        }
        else
        {
            <p class="text-muted mb-0">No subjects assigned yet.</p>
        }
    </div>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
