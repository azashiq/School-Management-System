@model Grade

@{
    ViewData["Title"] = "Delete Grade";
}

<div class="page-heading">
    <h2 class="mb-0"><i class="bi bi-trash text-danger"></i> Delete Grade</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
</div>

<div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> Are you sure you want to delete this grade record?</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Student</dt>
            <dd class="col-sm-9">@(Model.Student?.FullName ?? "-")</dd>
            <dt class="col-sm-3">Subject</dt>
            <dd class="col-sm-9">@(Model.Subject?.Name ?? "-")</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Score)</dt>
            <dd class="col-sm-9">@Model.Score</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirm Delete</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
