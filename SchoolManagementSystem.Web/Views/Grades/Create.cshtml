@model Grade

@{
    ViewData["Title"] = "Record Grade";
}

<div class="page-heading">
    <h2 class="mb-0"><i class="bi bi-award text-primary"></i> Record Grade</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="StudentId" class="form-label">Student</label>
                    <select asp-for="StudentId" class="form-select" asp-items="ViewBag.StudentId">
                        <option value="">-- Select Student --</option>
                    </select>
                    <span asp-validation-for="StudentId" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="SubjectId" class="form-label">Subject</label>
                    <select asp-for="SubjectId" class="form-select" asp-items="ViewBag.SubjectId">
                        <option value="">-- Select Subject --</option>
                    </select>
                    <span asp-validation-for="SubjectId" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="ExamType" class="form-label"></label>
                    <select asp-for="ExamType" class="form-select" asp-items="Html.GetEnumSelectList<ExamType>()"></select>
                    <span asp-validation-for="ExamType" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Score" class="form-label"></label>
                    <input asp-for="Score" type="number" step="0.01" min="0" max="100" class="form-control" />
                    <span asp-validation-for="Score" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="ExamDate" class="form-label"></label>
                    <input asp-for="ExamDate" type="date" class="form-control" />
                    <span asp-validation-for="ExamDate" class="text-danger"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Save Grade</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
