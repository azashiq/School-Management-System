@model Grade

@{
    ViewData["Title"] = "Grade Details";
}

<div class="page-heading">
    <h2 class="mb-0"><i class="bi bi-award text-primary"></i> Grade Details</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to List</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Student</dt>
            <dd class="col-sm-9">@(Model.Student?.FullName ?? "-")</dd>
            <dt class="col-sm-3">Subject</dt>
            <dd class="col-sm-9">@(Model.Subject?.Name ?? "-")</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ExamType)</dt>
            <dd class="col-sm-9">@Model.ExamType</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Score)</dt>
            <dd class="col-sm-9">@Model.Score</dd>
            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ExamDate)</dt>
            <dd class="col-sm-9">@Model.ExamDate.ToString("dd MMM yyyy")</dd>
        </dl>
    </div>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"><i class="bi bi-pencil"></i> Edit</a>
